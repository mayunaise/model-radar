---
interface Props { name: string; color?: string; }
const { name, color = "#a45532" } = Astro.props;
---
<span class="repo-mark"><i style={`--repo-color:${color}`} aria-hidden="true"></i>{name}</span>
<style>
  .repo-mark { display: inline-flex; align-items: center; gap: 0.42rem; color: var(--ink-soft); font-family: var(--mono); font-size: 0.72rem; }
  i { width: 0.48rem; height: 0.48rem; border-radius: 50%; background: var(--repo-color); }
</style>
