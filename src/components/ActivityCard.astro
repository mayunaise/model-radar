---
import type { ActivityItem } from "../lib/domain/types";
import { itemPath } from "../lib/site/routes";
import RepoMark from "./RepoMark.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props { item: ActivityItem; color?: string; }
const { item, color } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${itemPath(item.repository, item.number).replace(/^\//, "")}`;
const stateLabels = { open: "进行中", closed: "已关闭", merged: "已合并" };
---
<article class="activity-card panel">
  <div class="card-meta"><RepoMark name={item.repository} color={color} /><StatusBadge status={item.state} label={stateLabels[item.state]} /></div>
  <h3><a href={href}>{item.summary?.headlineZh ?? item.title}</a></h3>
  <p>{item.summary?.summaryZh ?? "摘要待生成，请查看上游原文。"}</p>
  <div class="card-footer"><span>{item.type === "pr" ? "PR" : "Issue"} #{item.number}</span><span>{item.summary?.category ?? "待分类"}</span><a href={item.url} rel="noreferrer">上游 ↗</a><time datetime={item.updatedAt}>{new Date(item.updatedAt).toLocaleString("zh-CN", { timeZone: "Asia/Shanghai", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}</time></div>
</article>
<style>
  .activity-card { display: flex; flex-direction: column; gap: 0.85rem; padding: 1.25rem; }
  .card-meta, .card-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  h3 a { min-height: auto; text-decoration: none; }
  p { color: var(--ink-soft); font-size: 0.9rem; }
  .card-footer { justify-content: flex-start; margin-top: auto; padding-top: 0.2rem; color: var(--ink-faint); font-family: var(--mono); font-size: 0.68rem; }
  .card-footer a { min-height: auto; }
  .card-footer time { margin-left: auto; }
</style>
