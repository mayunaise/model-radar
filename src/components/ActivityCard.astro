---
import type { ActivityItem, CategoryConfig } from "../lib/domain/types";
import { categoryForItem } from "../lib/domain/classification";
import { categoryLabel } from "../lib/config/categories";
import { hybridItemPath } from "../lib/site/hybrid";
import { sitePath } from "../lib/site/base";
import RepoMark from "./RepoMark.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props { item: ActivityItem; categories: CategoryConfig; anchorDate: string; color?: string; }
const { item, categories, anchorDate, color } = Astro.props;
const href = sitePath(hybridItemPath(item, anchorDate));
const stateLabels = { open: "进行中", closed: "已关闭", merged: "已合并" };
const classification = categoryForItem(item);
---
<article class="activity-card panel">
  <div class="card-meta"><RepoMark name={item.repository} color={color} /><StatusBadge status={item.state} label={stateLabels[item.state]} /></div>
  <h3><a href={href}>{item.summary?.headlineZh ?? item.title}</a></h3>
  <p class="card-summary">{item.summary?.summaryZh ?? "摘要待生成，请查看原始链接。"}</p>
  <div class="card-footer"><span>{item.type === "pr" ? "PR" : "Issue"} #{item.number}</span><span>{categoryLabel(categories, item.type, classification)}</span><a href={item.url} rel="noreferrer">原始链接 ↗</a><time datetime={item.updatedAt}>{new Date(item.updatedAt).toLocaleString("zh-CN", { timeZone: "Asia/Shanghai", year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}</time></div>
</article>
<style>
  .activity-card { display: flex; flex-direction: column; gap: 0.85rem; padding: 1.25rem; }
  .card-meta, .card-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  h3 a { display: -webkit-box; overflow: hidden; min-height: auto; line-height: 1.42; text-decoration: none; text-wrap: pretty; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .card-summary { display: -webkit-box; overflow: hidden; min-height: 4.2em; margin: 0; color: var(--ink-soft); font-size: 0.9rem; line-height: 1.55; text-wrap: pretty; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .card-footer { justify-content: flex-start; margin-top: auto; padding-top: 0.2rem; color: var(--ink-faint); font-family: var(--mono); font-size: 0.68rem; }
  .card-footer a { min-height: auto; }
  .card-footer time { margin-left: auto; }
</style>
