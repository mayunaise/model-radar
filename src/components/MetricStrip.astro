---
interface Metric { label: string; value: string | number; note: string; }
interface Props { metrics: Metric[]; }
const { metrics } = Astro.props;
---
<dl class="metrics panel">
  {metrics.map((metric) => <div><dt>{metric.label}</dt><dd>{metric.value}</dd><small>{metric.note}</small></div>)}
</dl>
<style>
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); margin: 2.5rem 0 0; overflow: hidden; }
  div { padding: 1.1rem 1.25rem; border-right: 1px solid var(--border); }
  div:last-child { border-right: 0; }
  dt { color: var(--ink-soft); font-size: 0.75rem; }
  dd { margin: 0.2rem 0 0; font-family: var(--serif); font-size: 1.8rem; line-height: 1.1; }
  small { color: var(--ink-faint); font-size: 0.68rem; }
  @media (max-width: 720px) { .metrics { grid-template-columns: 1fr 1fr; } div:nth-child(2) { border-right: 0; } div:nth-child(-n+2) { border-bottom: 1px solid var(--border); } }
</style>
