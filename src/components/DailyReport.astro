---
import type { ActivityItem, DailyReport as Report } from "../lib/domain/types";
import ActivityCard from "./ActivityCard.astro";
interface Props { report: Report; items: ActivityItem[]; colors?: Record<string, string>; }
const { report, items, colors = {} } = Astro.props;
const byId = new Map(items.map((item) => [item.id, item]));
---
<div class="report-groups">
  {report.groups.map((group) => (
    <section>
      <div class="section-heading"><h2>{group.title}</h2><span>{group.itemIds.length} 条</span></div>
      <div class="card-grid">{group.itemIds.map((id) => byId.get(id)).filter(Boolean).map((item) => <ActivityCard item={item!} color={colors[item!.repository]} />)}</div>
    </section>
  ))}
</div>
<style>
  .report-groups { display: grid; gap: 3.5rem; }
  .section-heading span { color: var(--ink-faint); font-size: 0.8rem; }
  .card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 760px) { .card-grid { grid-template-columns: 1fr; } }
</style>
