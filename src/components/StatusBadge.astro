---
interface Props { status: string; label?: string; }
const { status, label = status } = Astro.props;
const tone = ["merged", "supported", "complete", "ok"].includes(status) ? "positive" : ["open", "partial", "experimental", "planned", "watch"].includes(status) ? "attention" : ["error", "unsupported", "critical"].includes(status) ? "danger" : "neutral";
---
<span class:list={["badge", tone]}>{label}</span>
<style>
  .badge { display: inline-flex; align-items: center; width: fit-content; min-height: 1.65rem; padding: 0.1rem 0.52rem; border: 1px solid var(--border); border-radius: 999px; color: var(--ink-soft); background: var(--paper-raised); font-size: 0.72rem; font-weight: 750; letter-spacing: 0.02em; }
  .positive { color: #385448; border-color: #adc0b7; background: #e9f0ec; }
  .attention { color: #77551f; border-color: #d9c59b; background: #f5eddc; }
  .danger { color: #813d30; border-color: #dab1a9; background: #f5e8e4; }
</style>
