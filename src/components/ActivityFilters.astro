---
import type { RepositoryConfig } from "../lib/domain/types";
interface Props { repositories: RepositoryConfig["repositories"]; }
const { repositories } = Astro.props;
---
<form class="filters panel" data-activity-filters>
  <label class="search"><span>搜索</span><input type="search" name="q" placeholder="标题、摘要、模型…" /></label>
  <label><span>框架</span><select name="repository"><option value="">全部框架</option>{repositories.map((repo) => <option value={repo.slug}>{repo.framework}</option>)}</select></label>
  <label><span>类型</span><select name="type"><option value="">全部类型</option><option value="issue">Issue</option><option value="pr">PR</option></select></label>
  <label><span>状态</span><select name="state"><option value="">全部状态</option><option value="open">进行中</option><option value="merged">已合并</option><option value="closed">已关闭</option></select></label>
  <label><span>分类</span><select name="category"><option value="">全部分类</option><option value="NEW_SUPPORT">新增支持</option><option value="BUG">Bug</option><option value="FIX">修复</option><option value="PERFORMANCE">性能</option><option value="DOCS">文档</option><option value="COMPATIBILITY">兼容性</option><option value="OTHER">其他</option></select></label>
  <button type="reset">重置筛选</button>
</form>
<style>
  .filters { display: grid; grid-template-columns: 2fr repeat(4, 1fr) auto; align-items: end; gap: 0.8rem; padding: 1rem; }
  label { display: grid; gap: 0.3rem; }
  label span { color: var(--ink-soft); font-size: 0.72rem; font-weight: 700; }
  input, select, button { width: 100%; min-width: 0; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper-raised); padding: 0.55rem 0.65rem; }
  button { width: auto; cursor: pointer; color: var(--rust-deep); font-weight: 700; }
  @media (max-width: 980px) { .filters { grid-template-columns: repeat(2, 1fr); } .search { grid-column: 1 / -1; } }
  @media (max-width: 540px) { .filters { grid-template-columns: 1fr; } .search { grid-column: auto; } }
</style>
