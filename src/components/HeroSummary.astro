---
import type { DailyReport } from "../lib/domain/types";
interface Props { report: DailyReport; }
const { report } = Astro.props;
---
<section class="hero-summary">
  <div>
    <p class="eyebrow">{report.date} 日报</p>
    <h1>看见 GLM 生态<br />每天发生了什么。</h1>
  </div>
  <div class="abstract panel">
    <span>今日摘要</span>
    <p>{report.intro}</p>
    <small>AI 摘要，请回源核验</small>
  </div>
</section>
<style>
  .hero-summary { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr); align-items: end; gap: 3rem; padding: 2rem 0 1rem; }
  h1 { max-width: 13ch; }
  .abstract { padding: 1.4rem; border-top: 3px solid var(--rust); }
  .abstract > span { color: var(--rust-deep); font-size: 0.75rem; font-weight: 750; letter-spacing: 0.08em; }
  .abstract p { margin-top: 0.7rem; color: var(--ink-soft); }
  small { display: block; margin-top: 0.9rem; color: var(--ink-faint); }
  @media (max-width: 820px) { .hero-summary { grid-template-columns: 1fr; gap: 2rem; } }
</style>
