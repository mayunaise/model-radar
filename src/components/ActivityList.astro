---
import type { ActivityItem, CategoryConfig } from "../lib/domain/types";
import { categoryForItem } from "../lib/domain/classification";
import { modelNamesForItem } from "../lib/domain/models";
import { ACTIVITY_PAGE_SIZE } from "../scripts/activity-filter";
import ActivityCard from "./ActivityCard.astro";
interface Props { items: ActivityItem[]; colors: Record<string, string>; categories: CategoryConfig; anchorDate: string; }
const { items, colors, categories, anchorDate } = Astro.props;
const totalPages = Math.max(1, Math.ceil(items.length / ACTIVITY_PAGE_SIZE));
---
<div class="list-meta"><p data-result-count aria-live="polite">共 {items.length} 条 · 第 1/{totalPages} 页</p><p>按最近更新时间排序</p></div>
<div class="activity-grid">
  {items.map((item) => <div data-activity-item data-repository={item.repository} data-type={item.type} data-state={item.state} data-category={categoryForItem(item)} data-models={modelNamesForItem(item).join("|")}><ActivityCard item={item} categories={categories} anchorDate={anchorDate} color={colors[item.repository]} /></div>)}
</div>
<nav class="pagination panel" data-activity-pagination aria-label="全部动态分页">
  <button type="button" data-page-previous disabled>上一页</button>
  <div class="page-position">
    <span data-page-summary aria-live="polite">第 1 / {totalPages} 页</span>
    <div class="page-jump">
      <span>跳转至</span>
      <details class="page-picker" data-page-picker data-disabled={totalPages <= 1 ? "true" : "false"}>
        <summary data-page-select aria-label="跳转页码" aria-disabled={totalPages <= 1 ? "true" : "false"}>第 1 页</summary>
        <div class="page-options" data-page-options role="listbox" aria-label="选择页码">
          {Array.from({ length: totalPages }, (_, index) => <button type="button" role="option" aria-selected={index === 0 ? "true" : "false"} data-page-value={index + 1}>第 {index + 1} 页</button>)}
        </div>
      </details>
    </div>
  </div>
  <button type="button" data-page-next disabled={totalPages <= 1}>下一页</button>
</nav>
<noscript><p class="sample-note">浏览器未启用 JavaScript，当前显示全部记录；详情和原始链接仍可使用。</p></noscript>
<script>
  import { enhanceActivityFilters } from "../scripts/activity-filter";
  enhanceActivityFilters();
</script>
<style>
  .list-meta { display: flex; justify-content: space-between; margin: 1rem 0; color: var(--ink-faint); font-size: 0.78rem; }
  .activity-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  [data-activity-item] { display: grid; min-width: 0; }
  .pagination { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding: 0.8rem 1rem; }
  .pagination button, .page-picker summary { min-height: 2.2rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper-raised); padding: 0.35rem 0.65rem; }
  .pagination button { cursor: pointer; color: var(--rust-deep); font-weight: 700; }
  .pagination button:disabled, .page-picker[data-disabled="true"] { cursor: default; opacity: 0.45; }
  .page-position, .page-jump { display: flex; align-items: center; gap: 0.75rem; }
  .page-position { color: var(--ink-faint); font-size: 0.78rem; }
  .page-jump { padding-left: 0.75rem; border-left: 1px solid var(--border); }
  .page-jump > span { color: var(--ink-soft); font-weight: 600; white-space: nowrap; }
  .page-picker { position: relative; min-width: 7.75rem; }
  .page-picker summary {
    display: flex;
    box-sizing: border-box;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    min-height: 2.5rem;
    padding: 0.45rem 0.75rem 0.45rem 0.85rem;
    border-color: var(--border);
    border-radius: 9px;
    color: var(--ink);
    background: linear-gradient(180deg, rgb(255 255 255 / 72%), rgb(244 240 232 / 72%));
    box-shadow: 0 1px 0 rgb(255 255 255 / 85%) inset, 0 2px 7px rgb(51 42 32 / 5%);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 680;
    list-style: none;
    transition: border-color 150ms ease, box-shadow 150ms ease, background 150ms ease;
  }
  .page-picker:not([data-disabled="true"]) summary:hover,
  .page-picker[open] summary {
    border-color: rgb(164 85 50 / 55%);
    background: var(--paper-raised);
    box-shadow: 0 0 0 3px rgb(164 85 50 / 8%), 0 5px 14px rgb(51 42 32 / 8%);
  }
  .page-picker summary::-webkit-details-marker { display: none; }
  .page-picker summary::after {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    color: var(--rust-deep);
    content: "";
    transform: translateY(-2px) rotate(45deg);
    transition: transform 150ms ease;
  }
  .page-picker[open] summary::after { transform: translateY(2px) rotate(225deg); }
  .page-options {
    position: absolute;
    z-index: 20;
    right: 0;
    bottom: calc(100% + 0.5rem);
    display: grid;
    gap: 0.15rem;
    width: 100%;
    max-height: 13.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: rgb(164 85 50 / 38%) transparent;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    padding: 0.42rem;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: rgb(251 249 244 / 98%);
    box-shadow: 0 16px 38px rgb(58 45 35 / 16%), 0 1px 0 rgb(255 255 255 / 90%) inset;
  }
  .page-options::-webkit-scrollbar { width: 0.42rem; }
  .page-options::-webkit-scrollbar-thumb { border-radius: 99px; background: rgb(164 85 50 / 34%); }
  .page-options::-webkit-scrollbar-track { background: transparent; }
  .page-options :global(button) {
    position: relative;
    width: 100%;
    min-height: 2.25rem;
    border: 0;
    border-radius: 7px;
    padding: 0.38rem 1.8rem 0.38rem 0.65rem;
    color: var(--ink-soft);
    background: transparent;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 560;
    transition: color 120ms ease, background 120ms ease;
  }
  .page-options :global(button:hover) { color: var(--ink); background: var(--paper-deep); }
  .page-options :global(button[aria-selected="true"]) { color: var(--rust-deep); background: rgb(164 85 50 / 10%); font-weight: 720; }
  .page-options :global(button[aria-selected="true"]::after) { position: absolute; top: 50%; right: 0.7rem; color: var(--rust); content: "✓"; transform: translateY(-50%); }
  [hidden] { display: none; }
  @media (max-width: 760px) { .activity-grid { grid-template-columns: 1fr; } }
  @media (max-width: 540px) { .pagination, .page-position { align-items: stretch; flex-direction: column; } .pagination > button { width: 100%; } .page-jump { justify-content: space-between; padding-top: 0.7rem; padding-left: 0; border-top: 1px solid var(--border); border-left: 0; } .page-picker { min-width: 8.5rem; } }
</style>
