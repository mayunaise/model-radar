---
import type { ActivityItem } from "../lib/domain/types";
import ActivityCard from "./ActivityCard.astro";
interface Props { items: ActivityItem[]; colors: Record<string, string>; }
const { items, colors } = Astro.props;
---
<div class="list-meta"><p data-result-count aria-live="polite">{items.length} 条结果</p><p>按最近更新时间排序</p></div>
<div class="activity-grid">
  {items.map((item) => <div data-activity-item data-repository={item.repository} data-type={item.type} data-state={item.state} data-category={item.summary?.category ?? "OTHER"}><ActivityCard item={item} color={colors[item.repository]} /></div>)}
</div>
<noscript><p class="sample-note">浏览器未启用 JavaScript，当前显示全部记录；详情和上游链接仍可使用。</p></noscript>
<script>
  import { enhanceActivityFilters } from "../scripts/activity-filter";
  enhanceActivityFilters();
</script>
<style>
  .list-meta { display: flex; justify-content: space-between; margin: 1rem 0; color: var(--ink-faint); font-size: 0.78rem; }
  .activity-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  [hidden] { display: none; }
  @media (max-width: 760px) { .activity-grid { grid-template-columns: 1fr; } }
</style>
