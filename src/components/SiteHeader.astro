---
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, "")}`;
const nav = [
  { label: "日报", path: "/reports/" },
  { label: "动态", path: "/activity/" },
  { label: "能力矩阵", path: "/capabilities/" },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={href("/")} aria-label="GLM Radar 首页"><span class="brand-mark" aria-hidden="true">G</span><span>GLM Radar</span></a>
    <nav aria-label="主导航">
      <ul>{nav.map((item) => <li><a href={href(item.path)} aria-current={currentPath.includes(item.path) ? "page" : undefined}>{item.label}</a></li>)}</ul>
    </nav>
    <a class="github-link" href="https://github.com/" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--border); background: rgb(244 240 232 / 86%); backdrop-filter: blur(14px); }
  .header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 72px; gap: 1rem; }
  .brand { display: inline-flex; align-items: center; justify-self: start; gap: 0.65rem; font-family: var(--serif); font-size: 1.12rem; font-weight: 600; text-decoration: none; }
  .brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; color: var(--paper-raised); background: var(--rust); font-size: 0.94rem; }
  ul { display: flex; margin: 0; padding: 0; gap: 0.25rem; list-style: none; }
  nav a, .github-link { display: inline-flex; align-items: center; padding: 0.5rem 0.8rem; color: var(--ink-soft); font-size: 0.9rem; font-weight: 650; text-decoration: none; }
  nav a[aria-current="page"] { color: var(--ink); background: var(--paper-deep); border-radius: var(--radius-sm); }
  .github-link { justify-self: end; }
  @media (max-width: 720px) {
    .header-inner { grid-template-columns: 1fr auto; padding-block: 0.7rem; }
    nav { grid-column: 1 / -1; grid-row: 2; overflow-x: auto; }
    nav ul { width: 100%; justify-content: space-between; }
    .github-link { font-size: 0.82rem; }
  }
</style>
