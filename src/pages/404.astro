---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteBase } from "../lib/site/base";
---
<BaseLayout title="页面未找到｜GLM Radar">
  <div class="container not-found" data-legacy-redirect data-site-base={siteBase}>
    <p class="code">404</p>
    <p class="eyebrow">Signal not found</p>
    <h1>这条信号<br />不在雷达上。</h1>
    <p>页面可能已移动，或者上游条目尚未被收录。</p>
    <a href={siteBase}>返回首页 →</a>
  </div>
</BaseLayout>
<script>
  import { redirectLegacyRoute } from "../scripts/legacy-redirect";
  const root = document.querySelector<HTMLElement>("[data-legacy-redirect]");
  redirectLegacyRoute(root?.dataset.siteBase ?? "/");
</script>
<style>
  .not-found { max-width: 50rem; padding-block: 4rem; }
  .code { color: var(--rust); font-family: var(--mono); font-size: 0.8rem; }
  h1 { margin-top: 0.5rem; }
  .not-found > p:not(.code, .eyebrow) { margin-top: 1.4rem; color: var(--ink-soft); }
  a { display: inline-flex; margin-top: 1.5rem; color: var(--rust-deep); font-weight: 700; text-decoration: none; }
</style>
