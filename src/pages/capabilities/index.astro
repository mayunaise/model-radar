---
import CapabilityFilters from "../../components/CapabilityFilters.astro";
import CapabilityTable from "../../components/CapabilityTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadDataSnapshot } from "../../lib/data/load";
const { capabilities } = await loadDataSnapshot();
const frameworks = [...new Set(capabilities.map((entry) => entry.framework))];
---
<BaseLayout title="框架能力矩阵｜GLM Radar">
  <div class="container capability-page">
    <header><p class="eyebrow">Capability Matrix</p><h1>框架能力矩阵</h1><p>按 NPU / GPU、训练 / 推理 / RL 和框架筛选 GLM 支持状态。结论来自维护者审核的上游证据。</p></header>
    <CapabilityFilters frameworks={frameworks} />
    <CapabilityTable entries={capabilities} />
    <section class="method panel"><div><p class="eyebrow">Methodology</p><h2>证据与审核方法</h2></div><div><p>自动采集只会生成能力变更候选，不会直接改写公开矩阵。维护者在 Pull Request 中核实上游文档、合并记录或可复现实验后，才更新支持状态。</p><p>证据不足的条目统一显示为“待核实”，不会因为 AI 摘要或关键词命中被标记为“已支持”。</p></div></section>
  </div>
</BaseLayout>
<style>
  .capability-page > header { margin-bottom: 2rem; }
  h1 { font-size: clamp(2.7rem, 6vw, 4.8rem); }
  header p:not(.eyebrow) { max-width: 46rem; margin-top: 1rem; color: var(--ink-soft); }
  .method { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 2rem; margin-top: 3rem; padding: 1.6rem; }
  .method div:last-child { display: grid; gap: 0.8rem; color: var(--ink-soft); }
  @media (max-width: 720px) { .method { grid-template-columns: 1fr; } }
</style>
