---
import RepoMark from "../../../components/RepoMark.astro";
import StatusBadge from "../../../components/StatusBadge.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadProjectConfig } from "../../../lib/config/load";
import { loadDataSnapshot } from "../../../lib/data/load";
import type { ActivityItem } from "../../../lib/domain/types";
import { repositoryRouteKey } from "../../../lib/site/routes";

export async function getStaticPaths() {
  const { items } = await loadDataSnapshot();
  return items.map((item) => ({ params: { repo: repositoryRouteKey(item.repository), number: String(item.number) }, props: { item } }));
}
interface Props { item: ActivityItem; }
const { item } = Astro.props;
const config = await loadProjectConfig();
const repository = config.repositories.repositories.find((repo) => repo.slug === item.repository);
const stateLabels = { open: "进行中", closed: "已关闭", merged: "已合并" };
---
<BaseLayout title={`${item.summary?.headlineZh ?? item.title}｜GLM Radar`}>
  <article class="container detail">
    <a class="back" href={`${import.meta.env.BASE_URL}activity/`}>← 返回动态库</a>
    <header>
      <div class="meta"><RepoMark name={item.repository} color={repository?.color} /><StatusBadge status={item.state} label={stateLabels[item.state]} /></div>
      <p class="eyebrow">{item.type === "pr" ? "Pull Request" : "Issue"} #{item.number}</p>
      <h1>{item.summary?.headlineZh ?? item.title}</h1>
      <p class="upstream-title">上游标题：{item.title}</p>
    </header>
    <div class="detail-grid">
      <section class="panel summary"><h2>中文摘要</h2><p>{item.summary?.summaryZh ?? "摘要待生成，请查看上游原文。"}</p><p class="notice">AI 摘要，请回源核验</p></section>
      <aside class="panel"><h2>条目信息</h2><dl><div><dt>作者</dt><dd>{item.author}</dd></div><div><dt>更新</dt><dd><time datetime={item.updatedAt}>{new Date(item.updatedAt).toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" })}</time></dd></div><div><dt>分类</dt><dd>{item.summary?.category ?? "待分类"}</dd></div><div><dt>影响级别</dt><dd>{item.summary?.severity ?? "待判断"}</dd></div></dl></aside>
    </div>
    <section class="evidence"><h2>GLM 相关性依据</h2><ul>{(item.summary?.evidence ?? item.labels).map((entry) => <li>{entry}</li>)}</ul></section>
    <a class="source-cta" href={item.url} rel="noreferrer">查看 GitHub 原文 <span aria-hidden="true">↗</span></a>
  </article>
</BaseLayout>
<style>
  .detail { max-width: 62rem; }
  .back { display: inline-flex; margin-bottom: 2rem; color: var(--ink-soft); text-decoration: none; }
  header { max-width: 52rem; }
  .meta { display: flex; justify-content: space-between; margin-bottom: 1rem; }
  h1 { font-size: clamp(2.3rem, 5vw, 4.2rem); }
  .upstream-title { margin-top: 1rem; color: var(--ink-soft); }
  .detail-grid { display: grid; grid-template-columns: 1.5fr 0.75fr; gap: 1rem; margin-top: 2.5rem; }
  .summary, aside { padding: 1.4rem; }
  h2 { font-size: 1.35rem; }
  .summary > p { margin-top: 1rem; color: var(--ink-soft); }
  .summary .notice { color: var(--rust-deep); font-size: 0.78rem; font-weight: 700; }
  dl { margin: 1rem 0 0; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.5rem; border-bottom: 1px solid var(--border); }
  dt, dd { margin: 0; font-size: 0.78rem; }
  dt { color: var(--ink-faint); }
  .evidence { margin-top: 2.5rem; }
  .evidence ul { color: var(--ink-soft); }
  .source-cta { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; padding: 0.7rem 1rem; border-radius: var(--radius-sm); color: white; background: var(--rust); font-weight: 700; text-decoration: none; }
  @media (max-width: 720px) { .detail-grid { grid-template-columns: 1fr; } }
</style>
