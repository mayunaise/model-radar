---
import ActivityFilters from "../../components/ActivityFilters.astro";
import ActivityList from "../../components/ActivityList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadProjectConfig } from "../../lib/config/load";
import { loadDataSnapshot } from "../../lib/data/load";
import { sortItemsNewestFirst } from "../../lib/data/query";
const { items, meta } = await loadDataSnapshot();
const config = await loadProjectConfig();
const colors = Object.fromEntries(config.repositories.repositories.map((repo) => [repo.slug, repo.color]));
---
<BaseLayout title="Issue / PR 动态库｜GLM Radar">
  <div class="container activity-page">
    <header><p class="eyebrow">Activity Explorer</p><h1>Issue / PR 动态库</h1><p>搜索四个主流框架中与 GLM 相关的变更，查看结构化摘要后回到上游核验。</p><small>最后检查：{new Date(meta.lastCheckedAt).toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" })}</small></header>
    <ActivityFilters repositories={config.repositories.repositories} />
    <ActivityList items={sortItemsNewestFirst(items)} colors={colors} />
  </div>
</BaseLayout>
<style>
  .activity-page > header { margin-bottom: 2rem; }
  h1 { font-size: clamp(2.7rem, 6vw, 4.8rem); }
  header p:not(.eyebrow) { max-width: 44rem; margin-top: 1rem; color: var(--ink-soft); }
  small { color: var(--ink-faint); }
</style>
