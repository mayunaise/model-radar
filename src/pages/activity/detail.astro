---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteBase, sitePath } from "../../lib/site/base";
---
<BaseLayout title="动态详情｜GLM Radar">
  <article class="container detail" data-historical-item data-site-base={siteBase}>
    <a class="back" href={sitePath("activity/")}>← 返回开源动态</a>
    <p class="loading" data-loading>正在读取历史动态…</p>
    <div data-content hidden>
      <header>
        <div class="meta"><span class="repo" data-repository></span><span class="badge" data-state></span></div>
        <p class="eyebrow" data-reference></p>
        <h1 data-headline></h1>
        <p class="upstream-title">上游标题：<span data-title></span></p>
      </header>
      <div class="detail-grid">
        <section class="panel summary"><h2>中文摘要</h2><p data-summary></p><p class="notice">AI 摘要，请回源核验</p></section>
        <aside class="panel"><h2>条目信息</h2><dl><div><dt>作者</dt><dd data-author></dd></div><div><dt>更新</dt><dd data-updated></dd></div><div><dt>分类</dt><dd data-category></dd></div><div><dt>影响级别</dt><dd data-severity></dd></div></dl></aside>
      </div>
      <section class="evidence"><h2>GLM 相关性依据</h2><ul data-evidence></ul></section>
      <a class="source-cta" data-source rel="noreferrer">查看原始链接 <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</BaseLayout>
<script>
  import { loadHistoricalItem } from "../../scripts/historical-item";
  loadHistoricalItem();
</script>
<style>
  .detail { max-width: 62rem; }
  .back { display: inline-flex; margin-bottom: 2rem; color: var(--ink-soft); text-decoration: none; }
  .loading { color: var(--ink-soft); }
  header { max-width: 52rem; }
  .meta { display: flex; justify-content: space-between; margin-bottom: 1rem; }
  .repo, .badge { display: inline-flex; align-items: center; min-height: 1.65rem; padding: 0.1rem 0.55rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.72rem; font-weight: 750; }
  .repo::before { width: 0.42rem; height: 0.42rem; margin-right: 0.35rem; border-radius: 50%; background: var(--repo-color, var(--rust)); content: ""; }
  .badge[data-value="merged"] { color: #516b60; background: #e5ece7; }
  .badge[data-value="closed"] { color: #805743; background: #efe4dc; }
  h1 { font-size: clamp(2.3rem, 5vw, 4.2rem); }
  .upstream-title { margin-top: 1rem; color: var(--ink-soft); }
  .detail-grid { display: grid; grid-template-columns: 1.5fr 0.75fr; gap: 1rem; margin-top: 2.5rem; }
  .summary, aside { padding: 1.4rem; }
  h2 { font-size: 1.35rem; }
  .summary > p { margin-top: 1rem; color: var(--ink-soft); line-height: 1.75; white-space: pre-line; text-wrap: pretty; overflow-wrap: anywhere; }
  .summary .notice { color: var(--rust-deep); font-size: 0.78rem; font-weight: 700; }
  dl { margin: 1rem 0 0; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.5rem; border-bottom: 1px solid var(--border); }
  dt, dd { margin: 0; font-size: 0.78rem; }
  dt { color: var(--ink-faint); }
  .evidence { margin-top: 2.5rem; }
  .evidence ul { color: var(--ink-soft); }
  .source-cta { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; padding: 0.7rem 1rem; border-radius: var(--radius-sm); color: white; background: var(--rust); font-weight: 700; text-decoration: none; }
  @media (max-width: 720px) { .detail-grid { grid-template-columns: 1fr; } }
</style>
