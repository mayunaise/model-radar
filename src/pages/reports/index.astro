---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublicDataSnapshot } from "../../lib/data/query";
import { sitePath } from "../../lib/site/base";
import { hybridReportPath } from "../../lib/site/hybrid";
const { reports, meta } = await loadPublicDataSnapshot();
---
<BaseLayout title="日报归档｜GLM Radar">
  <div class="container archive">
    <p class="eyebrow">Daily Briefing</p><h1>日报归档</h1>
    <p class="intro">按北京时间归档 GLM 相关 Issue、PR 和修复摘要。每条信息都保留原始链接。</p>
    <ol>{reports.map((report) => <li class="panel"><a href={sitePath(hybridReportPath(report.date, meta.latestReportDate))}><time datetime={report.date}>{report.date}</time><strong>{report.intro}</strong><span>{report.groups.reduce((count, group) => count + group.itemIds.length, 0)} 条动态 →</span></a></li>)}</ol>
  </div>
</BaseLayout>
<style>
  .archive { max-width: 58rem; }
  h1 { font-size: clamp(2.8rem, 6vw, 4.8rem); }
  .intro { max-width: 42rem; margin-top: 1rem; color: var(--ink-soft); }
  ol { display: grid; gap: 0.8rem; margin: 2.5rem 0 0; padding: 0; list-style: none; }
  li a { display: grid; grid-template-columns: 8rem 1fr auto; align-items: center; gap: 1rem; padding: 1.2rem; text-decoration: none; }
  time { color: var(--rust-deep); font-family: var(--mono); font-size: 0.82rem; }
  strong { font-weight: 500; }
  span { color: var(--ink-faint); font-size: 0.78rem; }
  @media (max-width: 680px) { li a { grid-template-columns: 1fr; } }
</style>
