---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteBase } from "../../lib/site/base";
---
<BaseLayout title="历史日报｜GLM Radar">
  <article class="container report-page" data-historical-report data-site-base={siteBase}>
    <p data-loading>正在读取历史日报…</p>
    <div data-content hidden>
      <header><p class="eyebrow">Daily Briefing</p><h1><span data-date></span> 日报</h1><p data-intro></p><small>AI 摘要，请回源核验。能力结论以证据矩阵中的人工确认状态为准。</small></header>
      <section class="daily-changes">
        <div class="daily-change-heading"><h2>当日关键信息</h2><span data-count></span></div>
        <div class="daily-type-groups" data-groups></div>
      </section>
    </div>
  </article>
</BaseLayout>
<script>
  import { loadHistoricalReport } from "../../scripts/historical-report";
  loadHistoricalReport();
</script>
<style>
  .report-page > [data-content] > header { max-width: 54rem; margin-bottom: 3rem; }
  h1 { font-size: clamp(2.8rem, 6vw, 4.8rem); }
  header p:not(.eyebrow) { margin-top: 1rem; color: var(--ink-soft); font-size: 1.08rem; }
  small { display: block; margin-top: 0.8rem; color: var(--ink-faint); }
  .daily-change-heading, .daily-type-heading, .daily-item-badges { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .daily-change-heading { margin-bottom: 0.55rem; }
  .daily-change-heading h2 { font-size: 0.82rem; }
  .daily-change-heading span, .daily-type-heading span, .empty { color: var(--ink-faint); font-size: 0.76rem; }
  .daily-type-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .daily-type-group + .daily-type-group { padding-left: 2rem; border-left: 1px solid var(--border); }
  .daily-type-heading { padding-bottom: 0.42rem; }
  .daily-type-heading h3 { color: var(--ink-soft); font-family: var(--sans); font-size: 0.74rem; text-transform: uppercase; }
  .daily-scroll-region { height: 20rem; overflow-y: auto; border-top: 1px solid var(--border); }
  ol { margin: 0; padding: 0; list-style: none; }
  li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.8rem; padding: 0.72rem 0; border-bottom: 1px solid var(--border); }
  li a { display: grid; min-width: 0; gap: 0.16rem; text-decoration: none; }
  .reference { color: var(--rust-deep); font-family: var(--mono); font-size: 0.66rem; }
  li strong { font-size: 0.86rem; line-height: 1.4; }
  li p { display: -webkit-box; overflow: hidden; margin: 0.18rem 0 0; color: var(--ink-soft); font-size: 0.76rem; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .tag { min-height: 1.65rem; padding: 0.1rem 0.52rem; border: 1px solid var(--border); border-radius: 999px; color: var(--ink-soft); font-size: 0.72rem; font-weight: 750; }
  @media (max-width: 760px) { .daily-type-groups { grid-template-columns: 1fr; } .daily-type-group + .daily-type-group { padding: 1.25rem 0 0; border-top: 1px solid var(--border); border-left: 0; } }
</style>
