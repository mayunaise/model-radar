---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DailyReport from "../../components/DailyReport.astro";
import { loadPublicDataSnapshot } from "../../lib/data/query";
import type { ActivityItem, DailyReport as Report } from "../../lib/domain/types";
import { isRecentReport } from "../../lib/site/hybrid";

export async function getStaticPaths() {
  const { reports, items, meta } = await loadPublicDataSnapshot();
  return reports
    .filter((report) => isRecentReport(report.date, meta.latestReportDate))
    .map((report) => ({ params: { date: report.date }, props: { report, items } }));
}

interface Props { report: Report; items: ActivityItem[]; }
const { report, items } = Astro.props;
const { repositories, meta } = await loadPublicDataSnapshot();
const frameworks = Object.fromEntries(repositories.map((repo) => [repo.slug, { name: repo.framework, color: repo.color }]));
---
<BaseLayout title={`${report.date} 日报｜GLM Radar`}>
  <article class="container report-page">
    <header><p class="eyebrow">Daily Briefing</p><h1>{report.date} 日报</h1><p>{report.intro}</p><small>AI 摘要，请回源核验。能力结论以证据矩阵中的人工确认状态为准。</small></header>
    {report.sample && <p class="sample-note">当前为首版本地样例数据；所有条目均为样例，不对应真实 Issue 或 PR。</p>}
    <DailyReport report={report} items={items} frameworks={frameworks} anchorDate={meta.latestReportDate} />
  </article>
</BaseLayout>
<style>
  .report-page > header { max-width: 54rem; margin-bottom: 3rem; }
  h1 { font-size: clamp(2.8rem, 6vw, 4.8rem); }
  header p:not(.eyebrow) { margin-top: 1rem; color: var(--ink-soft); font-size: 1.08rem; }
  small { display: block; margin-top: 0.8rem; color: var(--ink-faint); }
</style>
